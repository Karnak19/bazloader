---
// The whole app is this one page: changing page in Astro is a full page load, which would drop
// the Web Bluetooth connection. The island switches between screens itself.
// client:only because navigator.bluetooth does not exist at build time.
// The page is built with lang="fr"; src/i18n/index.ts sets it to the language shown once the
// island starts, and again on every switch.
import { App } from '../app.tsx'
import '../style.css'

const base = import.meta.env.BASE_URL

// Variable fonts: one file per family covers every weight. Declared here because the URL needs the
// site's base path.
const fontFaces = `
@font-face { font-family: 'Geist'; src: url('${base}fonts/Geist.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
@font-face { font-family: 'Geist Mono'; src: url('${base}fonts/GeistMono.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
`
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="description" content="Chargeur de billes BazLoader piloté en Bluetooth" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon-180x180.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>BazLoader</title>
    <!-- Geist and Geist Mono (SIL OFL, see public/fonts/OFL.txt), served from the site and
         precached by the service worker, so they are there on a field with no network. -->
    <link rel="preload" href={`${base}fonts/Geist.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/GeistMono.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    <!-- Before first paint: apply the theme picked in Réglages, so the page never flashes the other
         one. Same key and colours as src/ui/theme.ts, which takes over once the island runs. -->
    <script is:inline>
      try {
        var pref = localStorage.getItem('bazloader.theme')
        if (pref === 'light' || pref === 'dark') document.documentElement.setAttribute('data-theme', pref)
        var dark = pref === 'dark' || (pref !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#0b0c0e' : '#f6f4ef')
      } catch (e) {}
    </script>
  </head>
  <body>
    <App client:only="preact" />
    <script>
      // sw.js lives at the site root but only controls /app/, so the docs always hit the network.
      // The worker activates on install (autoUpdate), so the next load gets the new version.
      if ('serviceWorker' in navigator) {
        const base = import.meta.env.BASE_URL
        navigator.serviceWorker.register(`${base}sw.js`, { scope: `${base}app/` })
      }
    </script>
  </body>
</html>
